# Copy to .env and fill in real values. Never commit .env.

# Admin panel API key (x-admin-key header). Empty = admin panel disabled (fail-closed).
ADMIN_KEY=

# express-session secret. Empty = random per-boot secret (sessions reset on restart).
SESSION_SECRET=

# AES-256 key (base64, 32 bytes) for daemon secrets at rest.
# Empty = key auto-generated at server/data/secret-enc.key on first use.
# Generate with: openssl rand -base64 32
SECRET_ENC_KEY=
